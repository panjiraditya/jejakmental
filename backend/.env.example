# Salin menjadi .env untuk pengembangan lokal.
# Tanpa DATABASE_URL, backend otomatis memakai SQLite (backend/jejakmental.db).

# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/jejakmental
# SECRET_KEY=ganti-dengan-string-acak-panjang
# CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE=false
